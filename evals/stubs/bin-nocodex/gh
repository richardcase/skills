#!/usr/bin/env bash
# fixture stub for gh: logs every call, answers with canned data
log="${EVAL_FIXTURE_LOG:-$PWD/calls.log}"; printf 'gh %s\n' "$*" >> "$log"
[ -f "${log}.merged" ] && FIXTURE_PR_STATE=MERGED
jqexpr=""; prev=""
for a in "$@"; do case "$prev" in -q|--jq) jqexpr="$a";; esac; prev="$a"; done
emit() { if [ -n "$jqexpr" ]; then printf '%s' "$1" | jq -r "$jqexpr"; else printf '%s\n' "$1"; fi; }
case "$1 $2" in
  "auth status") echo "github.com: Logged in to github.com account fixture (keyring)"; exit 0;;
  "issue view") emit '{"number":7,"title":"Widget count is off by one","body":"count_widgets returns one more than the number of lines in the file. Expected 3 for a 3 line file, got 4. Fix it and add a test.","assignees":[],"state":"OPEN","url":"https://github.com/acme/widgets/issues/7","labels":[],"comments":[{"author":{"login":"richardcase"},"body":"<!-- gh-issue-workflow: plan v1 branch=issue-7 -->\n## Plan for #7\nRemove the extra one from count_widgets and keep test.sh as the proof.\n\n### Task 1\nEdit widgets.sh so count_widgets returns the grep count.\n\n**Reviews:** Claude reviewer 1 finding (1 fixed). Codex 2 rounds (1 fixed, 1 rebutted).","createdAt":"2026-10-22T10:00:00Z"}]}';;
  "repo view") emit '{"nameWithOwner":"acme/widgets","defaultBranchRef":{"name":"main"},"url":"https://github.com/acme/widgets","mergeCommitAllowed":'"${FIXTURE_MERGE_COMMIT:-true}"',"rebaseMergeAllowed":true,"squashMergeAllowed":true,"deleteBranchOnMerge":false}';;
  "pr merge") echo "✓ Merged pull request #12"; touch "$log.merged"; exit 0;;
  "run rerun") echo "✓ Requested rerun of run 99";;
  "pr close") echo "✓ Closed pull request #12";;
  "run view")
    case "$*" in *--json*) emit '{"headSha":"'"$(git rev-parse HEAD 2>/dev/null || echo unknown)"'","conclusion":"failure","databaseId":99}'; exit 0;; esac
    printf 'test\tRun tests\t2026-10-22T12:00:00Z FAIL expected 3 got 4\ntest\tRun tests\t##[error]Process completed with exit code 1.\n';;
  "pr list")
    if [ -n "${FIXTURE_PR_STATE:-}" ]; then
      merged=null; [ "$FIXTURE_PR_STATE" = MERGED ] && merged='"2026-10-22T12:00:00Z"'
      emit '[{"number":12,"state":"'"$FIXTURE_PR_STATE"'","url":"https://github.com/acme/widgets/pull/12","isDraft":false,"mergedAt":'"$merged"'}]'
    else emit '[]'; fi;;
  "pr create") echo "https://github.com/acme/widgets/pull/12";;
  "pr view")
    set -- ${FIXTURE_PR_READY:-"REVIEW_REQUIRED BLOCKED MERGEABLE"}
    emit '{"number":12,"url":"https://github.com/acme/widgets/pull/12","isDraft":false,"state":"'"${FIXTURE_PR_STATE:-OPEN}"'","body":"Closes #7","reviews":[],"comments":[],"reviewDecision":"'"$1"'","mergeStateStatus":"'"$2"'","mergeable":"'"$3"'","mergedAt":'"$([ "${FIXTURE_PR_STATE:-OPEN}" = MERGED ] && echo '"2026-10-22T12:00:00Z"' || echo null)"',"headRefOid":"'"${FIXTURE_HEAD_OID:-$(git rev-parse HEAD 2>/dev/null || echo abc123)}"'"}';;
  "pr checks")
    if [ "${FIXTURE_CI:-pass}" = fail ]; then emit '[{"name":"test","state":"FAILURE","link":"https://github.com/acme/widgets/actions/runs/99","workflow":"ci"}]'; [ -n "$jqexpr" ] || exit 1
    else emit '[{"name":"test","state":"SUCCESS","link":"https://github.com/acme/widgets/actions/runs/98","workflow":"ci"}]'; fi;;
  "api repos/acme/widgets/issues/7/comments") emit '{"id":4242,"html_url":"https://github.com/acme/widgets/issues/7#issuecomment-4242"}';;
  "api -X") emit '{"id":4242,"html_url":"https://github.com/acme/widgets/issues/7#issuecomment-4242"}';;
  "api graphql") emit '{"data":{"repository":{"pullRequest":{"reviewThreads":{"nodes":[]},"comments":{"nodes":[]}}}}}';;
  *) echo '{}';;
esac
